+        # Bound by address, but pcr.py:112-116 rewrites it: the record must still show
+        # that the reader consumed a Part this run produced, so it is not a hit.
+        pcr.calc(
+            "B",
+            Calculation("fn.spec.read", read_part),
+            id="second",
